# Normalize line endings: keep LF in the repository for text files.
* text=auto eol=lf

# Treat common binary/image formats as binary (no diff/merge mangling).
*.png binary
*.webp binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.tgs binary
*.webm binary

# Data files
*.csv text
*.json text
*.md text

# Pinned third-party renderer; first-party production code is Rust.
runtime/vendor/** linguist-vendored -whitespace

# Generated upstream license quotations retain their original text verbatim.
THIRD_PARTY_NOTICES.md -whitespace
